{
  "name": "@20minutes/content-slug",
  "version": "2.0.1",
  "description": "Content slugification for 20 Minutes",
  "license": "MIT",
  "repository": "20minutes/content-slug",
  "type": "module",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "yarn clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.cjs",
    "es-check": "yarn es-check:esm && yarn es-check:cjs",
    "es-check:esm": "es-check es2022 './lib/esm/**/*.js' --module --checkFeatures",
    "es-check:cjs": "es-check es2022 './lib/cjs/**/*.js' --checkFeatures",
    "typecheck": "tsc -p tsconfig.json",
    "test": "yarn build && vitest run --coverage",
    "lint": "biome check --max-diagnostics=none",
    "lint:fix": "biome check --write --unsafe --max-diagnostics=none"
  },
  "devDependencies": {
    "@20minutes/eslint-config": "^3.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "es-check": "^9.6.4",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "url-slug": "^5.0.0"
  }
}
